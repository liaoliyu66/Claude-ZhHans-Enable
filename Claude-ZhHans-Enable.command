#!/bin/bash
set -euo pipefail
mode="${1:-}"
if [[ -z "$mode" ]]; then
    printf '\nClaude 简体中文界面工具\n'
    printf '%s\n' '1) 设置中文' '2) 还原最近一次备份' '0) 退出'
    printf '请选择 [1/2/0]: '
    if ! IFS= read -r choice; then
        printf '\n未读取到选项，已退出。\n'
        exit 2
    fi
    case "$choice" in
        1) mode="install" ;;
        2)
            printf '将还原最近一次安装备份。继续？[y/N]: '
            if ! IFS= read -r confirm || [[ ! "$confirm" =~ ^[Yy]$ ]]; then
                printf '已取消还原。\n'
                exit 0
            fi
            mode="--restore"
            ;;
        0) printf '已退出。\n'; exit 0 ;;
        *) printf '选项无效，请输入 1、2 或 0。\n' >&2; exit 2 ;;
    esac
fi
case "$mode" in
    --help|-h|help)
        printf '%s\n' '用法：Claude-ZhHans-Enable.command [--dry-run|--restore|--help]' \
            '不带参数启动时显示中文菜单。--restore 会还原最近一次安装备份。'
        exit 0
        ;;
esac
exec /usr/bin/python3 - "$0" "$mode" <<'PYINSTALL'
from __future__ import annotations
import base64, datetime, gzip, hashlib, json, os, plistlib, re, shlex, shutil, subprocess, sys, tempfile
from pathlib import Path

installer=Path(sys.argv[1]).resolve()
mode=sys.argv[2]
if mode not in ("install","--dry-run","--restore"):
    print("用法：Claude-ZhHans-Enable.command [--dry-run|--restore|--help]",file=sys.stderr); raise SystemExit(2)
src=installer.read_text(encoding="utf-8")
def embedded(name):
    m=re.search(r"(?ms)^# BEGIN_"+re.escape(name)+r"\n(.*?)^# END_"+re.escape(name)+r"$",src)
    if not m: raise RuntimeError("内嵌语言资源缺失："+name)
    return base64.b64decode("".join(m.group(1).split()))
zh=gzip.decompress(embedded("ZH_HANS_GZIP_B64"))
dyn=gzip.decompress(embedded("ZH_HANS_DYNAMIC_GZIP_B64"))
zh_obj=json.loads(zh); dyn_obj=json.loads(dyn)
if not isinstance(zh_obj,dict) or len(zh_obj)<1000 or not isinstance(dyn_obj,dict):
    raise RuntimeError("内嵌中文语言包校验失败。")

app=Path(os.environ.get("CLAUDE_APP_PATH","/Applications/Claude.app")).expanduser().resolve()
res=app/"Contents/Resources"; ion=res/"ion-dist"; assets_dir=ion/"assets/v1"
user_data=Path(os.environ.get("CLAUDE_USER_DATA_DIR",str(Path.home()/"Library/Application Support/Claude-3p"))).expanduser()
config_path=user_data/"config.json"
if not res.is_dir() or not assets_dir.is_dir(): raise RuntimeError(f"找不到 Claude 资源目录：{res}；如安装路径不同，请设置 CLAUDE_APP_PATH。")
if not (res/"zh-Hans.json").is_file(): raise RuntimeError("Claude 原生简体中文菜单资源缺失，未修改文件。")
try: version=plistlib.loads((app/"Contents/Info.plist").read_bytes()).get("CFBundleShortVersionString","unknown")
except Exception: version="unknown"

shared=[]; labels=[]
for p in assets_dir.glob("*.js"):
    try: s=p.read_text(encoding="utf-8")
    except Exception: continue
    if "var jv=[" in s and 'var Gv="en-US",Kv=[' in s: shared.append((p,s))
    if '"ja-JP":{name:"Japanese (Japan)"' in s and '"zh-Hant":{name:"Chinese (Traditional)"' in s and 'function M(e,t={})' in s: labels.append((p,s))
if len(shared)!=1: raise RuntimeError(f"未能唯一定位语言注册脚本（找到 {len(shared)} 个），未修改文件。")
if len(labels)!=1: raise RuntimeError(f"未能唯一定位语言名称脚本（找到 {len(labels)} 个），未修改文件。")
shared_path,shared_text=shared[0]; label_path,label_text=labels[0]
def add_locale(text,pattern,locale,what):
    ms=list(re.finditer(pattern,text))
    if len(ms)!=1: raise RuntimeError(f"未能唯一定位{what}语言列表，未修改文件。")
    m=ms[0]; vals=re.findall(r'"([^"]+)"',m.group(1))
    if locale in vals: return text,False
    updated=m.group(1)+("," if m.group(1) else "")+'"'+locale+'"'
    return text[:m.start(1)]+updated+text[m.end(1):],True
shared_text,jv_changed=add_locale(shared_text,r'var\s+jv=\[([^\]]*)\]',"zh-Hans","renderer")
shared_text,kv_changed=add_locale(shared_text,r'var\s+Gv="en-US",Kv=\[([^\]]*)\]',"zh-Hans","system-language")
marker="function M(e,t={})"
if label_text.count(marker)!=1: raise RuntimeError("语言名称表结构已变化，未修改文件。")
prefix,rest=label_text.split(marker,1)
new_label='"zh-Hans":{name:"Chinese (Simplified)",localName:"中文（简体）"}'
if '"zh-Hans":{name:"Chinese (Simplified)"' in prefix:
    if new_label not in prefix: raise RuntimeError("语言选择表中的中文名称与预期不符，未修改文件。")
    name_changed=False
else:
    anchor='"id-ID":{name:"Indonesian (Indonesia)",localName:"Indonesia (Indonesia)"}'
    if prefix.count(anchor)!=1: raise RuntimeError("未能定位语言名称插入点，未修改文件。")
    prefix=prefix.replace(anchor,anchor+","+new_label,1)
    label_text=prefix+marker+rest; name_changed=True

zh_path=ion/"i18n/zh-Hans.json"; dyn_path=ion/"i18n/dynamic/zh-Hans.json"
planned={zh_path:zh,dyn_path:dyn,shared_path:shared_text.encode(),label_path:label_text.encode()}
try: config=json.loads(config_path.read_text(encoding="utf-8")) if config_path.exists() else {}
except Exception as e: raise RuntimeError(f"无法解析配置文件 {config_path}：{e}")
if not isinstance(config,dict): raise RuntimeError(f"配置文件格式应为 JSON 对象：{config_path}")
if config.get("locale")!="zh-Hans":
    config["locale"]="zh-Hans"
    planned[config_path]=(json.dumps(config,ensure_ascii=False,indent="\t")+"\n").encode()
changed={p:b for p,b in planned.items() if not p.exists() or p.read_bytes()!=b}
if mode=="--restore":
    print(f"Claude 版本：{version}；程序路径：{app}")
    print("操作：还原最近一次安装快照。")
else:
    print(f"Claude 版本：{version}；程序路径：{app}")
    print(f"简体中文语言包：{len(zh_obj)} 项；动态语言包：{len(dyn_obj)} 项")
    print(f"语言注册：选择器={'新增' if jv_changed else '已存在'}；系统自动识别={'新增' if kv_changed else '已存在'}；中文名称={'新增' if name_changed else '已存在'}")
    for p in planned: print(("将写入：" if p in changed else "无需改动：")+str(p))
if mode=="--dry-run": print("预览完成，未修改任何文件。"); raise SystemExit(0)

backup_root=Path.home()/"Library/Application Support/Claude-Locale-Backups"
ps=subprocess.run(["/bin/ps","-Ao","command="],text=True,capture_output=True).stdout
claude_executable=str((app/"Contents/MacOS/Claude").resolve())
def running_for_user_data():
    for line in ps.splitlines():
        try: argv=shlex.split(line)
        except ValueError: continue
        if not argv or argv[0]!=claude_executable: continue
        for i,arg in enumerate(argv):
            if arg.startswith("--user-data-dir="):
                if str(Path(arg.split("=",1)[1]).expanduser().resolve())==str(user_data.resolve()): return True
            elif arg=="--user-data-dir" and i+1<len(argv):
                if str(Path(argv[i+1]).expanduser().resolve())==str(user_data.resolve()): return True
    return False
if running_for_user_data():
    raise RuntimeError("对应的 Claude-3p 进程当前正在运行。请完全退出 Claude 后重新执行。")
if mode=="--restore":
    folders=sorted((p for p in backup_root.glob("*") if p.is_dir() and (p/"manifest.json").is_file()),key=lambda p:p.name)
    if not folders: raise RuntimeError(f"没有可用的安装备份：{backup_root}")
    folder=folders[-1]; manifest=json.loads((folder/"manifest.json").read_text())
    for item in manifest["files"]:
        dest=Path(item["path"])
        if item["existed"]: shutil.copy2(folder/item["backup"],dest)
        elif dest.exists(): dest.unlink()
    print("已还原备份：",folder); raise SystemExit(0)

if not changed: print("中文界面已设置，无需再次修改。"); raise SystemExit(0)
backup_root.mkdir(parents=True,exist_ok=True)
stamp=datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
backup=backup_root/(stamp+"-Claude-"+version.replace("/","_")); files=backup/"files"; files.mkdir(parents=True)
manifest={"created":stamp,"app":str(app),"version":version,"files":[]}
for i,(dest,payload) in enumerate(changed.items()):
    existed=dest.exists(); saved=f"files/{i:02d}-{dest.name}" if existed else None
    if existed: shutil.copy2(dest,backup/saved)
    manifest["files"].append({"path":str(dest),"existed":existed,"backup":saved,"sha256_before":hashlib.sha256(dest.read_bytes()).hexdigest() if existed else None})
(backup/"manifest.json").write_text(json.dumps(manifest,indent=2)+"\n")
def atomic_write(path,payload):
    path.parent.mkdir(parents=True,exist_ok=True); modebits=path.stat().st_mode&0o777 if path.exists() else 0o644
    fd,tmp=tempfile.mkstemp(prefix="."+path.name+".",dir=str(path.parent))
    try:
        with os.fdopen(fd,"wb") as f: f.write(payload); f.flush(); os.fsync(f.fileno())
        os.chmod(tmp,modebits); os.replace(tmp,path)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)
try:
    for dest,payload in changed.items(): atomic_write(dest,payload)
    for dest,payload in planned.items():
        if dest.read_bytes()!=payload: raise RuntimeError("写入后校验不一致："+str(dest))
    json.loads(zh_path.read_text()); json.loads(dyn_path.read_text())
    print("简体中文界面已设置并通过校验。备份位置：",backup)
    print("日文语言包和 Magpie API 配置未修改。")
    print("请重新启动 Claude-3p 加载语言设置。")
except Exception:
    print("安装未完整完成。如需恢复最近一次快照，请重新运行并在菜单中选择“还原”。",file=sys.stderr); raise
PYINSTALL
